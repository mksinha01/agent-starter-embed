# ============================================
# Pipecat Voice AI Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED: Daily.co (WebRTC Transport)
# ============================================
# Get your API key from: https://dashboard.daily.co/developers
DAILY_API_KEY=your_daily_api_key_here

# ============================================
# Speech-to-Text (STT) - Choose ONE
# ============================================

# Deepgram (Recommended)
# Get key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# AssemblyAI (Alternative)
# ASSEMBLYAI_API_KEY=your_assemblyai_key

# Azure Speech (Alternative)
# AZURE_SPEECH_KEY=your_azure_key
# AZURE_SPEECH_REGION=eastus

# Google Cloud Speech (Alternative)
# GOOGLE_CREDENTIALS_JSON=/path/to/credentials.json

# ============================================
# Text-to-Speech (TTS) - Choose ONE
# ============================================

# Cartesia (Recommended - Low latency)
# Get key from: https://cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key_here

# ElevenLabs (Alternative - High quality)
# ELEVENLABS_API_KEY=your_elevenlabs_key

# OpenAI TTS (Alternative - Simple)
# OPENAI_API_KEY=your_openai_key

# ============================================
# Language Model (LLM) - Choose ONE
# ============================================

# Google Gemini (Recommended - Fast & Free tier)
# Get key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT (Alternative)
# OPENAI_API_KEY=your_openai_key

# Anthropic Claude (Alternative)
# ANTHROPIC_API_KEY=your_anthropic_key

# Groq (Alternative - Ultra fast)
# GROQ_API_KEY=your_groq_key

# ============================================
# Optional: Additional Services
# ============================================

# Sarvam AI (Optional - Multilingual Indian languages)
# SARVAM_AI_API_KEY=your_sarvam_key

# AWS Services (Optional)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# ============================================
# Application Configuration
# ============================================

# Backend port (default: 8001)
PORT=8001

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable metrics collection
ENABLE_METRICS=true

# ============================================
# Frontend Configuration (if using included frontend)
# ============================================

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in AT LEAST these keys:
#    - DAILY_API_KEY (required)
#    - One STT service key (e.g., DEEPGRAM_API_KEY)
#    - One TTS service key (e.g., CARTESIA_API_KEY)
#    - One LLM service key (e.g., GOOGLE_API_KEY)
# 3. Save the file
# 4. Start the application
#
# For detailed setup guide, see: README.md
# ============================================
